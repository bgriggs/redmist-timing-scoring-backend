{
  "NLog": {
    "throwConfigExceptions": true,
    "targets": {
      "console": {
        "type": "ColoredConsole",
        "layout": "${longdate}|${pad:padding=5:inner=${level:uppercase=true}}|${logger}|${message}${onexception:inner=|${exception:format=tostring}${newline}${exception:format=tostring:maxInnerExceptionLevel=10}}",
        "rowHighlightingRules": [
          {
            "condition": "level == LogLevel.Trace",
            "foregroundColor": "Gray"
          },
          {
            "condition": "level == LogLevel.Info",
            "foregroundColor": "Green"
          },
          {
            "condition": "level == LogLevel.Warning",
            "foregroundColor": "Yellow"
          },
          {
            "condition": "level == LogLevel.Error",
            "foregroundColor": "Red"
          },
          {
            "condition": "level == LogLevel.Fatal",
            "foregroundColor": "Red",
            "backgroundColor": "White"
          }
        ]
      }
    },
    "rules": [
      {
        "logger": "System.*",
        "finalMinLevel": "Error"
      },
      {
        "logger": "Microsoft.*",
        "finalMinLevel": "Error"
      },
      {
        "logger": "*",
        "minLevel": "Trace",
        "writeTo": "console"
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Claude": {
    "ApiKey": ""
  },
  "Assets": {
    "StorageZoneName": "",
    "StorageAccessKey": "",
    "MainReplicationRegion": "",
    "ApiAccessKey": "",
    "//PublicBaseUrl": "Where the assets zone is readable. Left blank so it is derived as https://{StorageZoneName}.b-cdn.net, which keeps test and production pointing at their own zones automatically.",
    "PublicBaseUrl": ""
  },
  "Social": {
    "Channel": "Facebook",
    "Model": "claude-sonnet-5",
    "MaxTokens": 1024,
    "MaxAttempts": 3,
    "MaxCharacters": 1200,
    "SettleHours": 24,
    "LookbackDays": 14,
    "MaxEventsPerRun": 10,
    "Images": {
      "Enabled": true,
      "BaseUrl": "https://redmist.racing",
      "//QueryString": "The landing UI embed flag, which drops the site toolbar and footer at the Angular level rather than hiding them after they render.",
      "QueryString": "embed=1&groupClass=1&expand=1&topPerClass=3",
      "MaxPerPost": 2,
      "ViewportWidth": 900,
      "ViewportHeight": 1500,
      "DeviceScaleFactor": 2,
      "ReadySelector": ".car-row-container",
      "//ClipSelector": "Safe only because topPerClass bounds the panel height: six classes at three cars each is about 900x1185. Set empty to fall back to a viewport capture.",
      "ClipSelector": ".timing-viewer",
      "HideSelectors": ".mat-mdc-tab-header,app-sponsor-rotator,app-sponsor-marquee,.header-left,.header-right",
      "//BlockedUrlSubstrings": "Sponsor impressions are recorded as the page renders. A nightly screenshot run would otherwise invent impressions, for events that finished days ago, seen by nobody, into the data the sponsor reports are computed from.",
      "BlockedUrlSubstrings": "/SponsorTelemetry/",
      "ReadyTimeoutSeconds": 45,
      "SettleSeconds": 4
    }
  }
}
